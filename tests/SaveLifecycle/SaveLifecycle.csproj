<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../Assets/Scripts/Save/**/*.cs" />
    <Compile Include="../../Assets/Scripts/ProgressionHost/ProgressionLauncher.cs" />
    <Compile Include="../../Assets/Scripts/ProgressionHost/ProgressionSaveBridge.cs" />
    <!--
      진행 코어/런타임은 순수 C#이라 그대로 컴파일한다.
      ProgressionDriver만 뺀다 - 실행 횟수와 Stop을 관찰해야 해서 Stubs.cs가 대역을 세운다.
    -->
    <Compile Include="../../Assets/Scripts/Ked.Progression/**/*.cs"
             Exclude="../../Assets/Scripts/Ked.Progression/Tests/**/*.cs;../../Assets/Scripts/Ked.Progression/ProgressionDriver.cs" />
    <Compile Include="../../Assets/Scripts/FeatureController/BacklogRecorder.cs" />
    <Compile Include="../../Assets/Scripts/DialoguePresenter/VNOptionFlow/VNChoiceRecord.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
