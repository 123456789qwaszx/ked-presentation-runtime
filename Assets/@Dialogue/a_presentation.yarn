<<await 1>>
<<pause 0.8>>

<<await 1>>
<<fade_in Willow 1.2>>

<<await 1>>
<<fade_in Laru 1.2>>

<<await 1>>
<<box_hide 3>>

<<await 1>>
<<bg_fade_out green all 1.5>>

