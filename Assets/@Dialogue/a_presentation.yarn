<<shot_reset>>

<<slot Leafia 0>>
<<cast Leafia Matilda a 02 true left normal>>

<<slot Albedo 0>>
<<cast Albedo Albedo a 02 true right normal>>


<<spawn_bg rigKey stage00 green back 5 0 0 30>>
<<spawn_bg bg0 stage00 black back 0.9 0 -90 0>>
<<spawn_bg bg2 stage00 white back 0.5 0 -250 0>>

<<idle_breathe Leafia 99 5 0.25>>

<<shot_bind_char_response Leafia 0>>
<<shot_bind_char_response Albedo 0>>

<<shot_bind_bg_response rigKey>>
<<shot_bind_bg_response bg0>>
<<shot_bind_bg_response bg2>>
