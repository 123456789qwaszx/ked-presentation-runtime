<<hold_begin>>
<<spawn_bg green a green back>>


<<await 1>>
<<pause 1.5>>

<<await 1>>
<<box_hide 3>>


<<await 1>>
<<pause 1.5>>

<<move_by Willow 300 400>>
<<await 1>>
<<fade_in Willow 2.5>>


<<await 1>>
<<bg_fade_out green all 2.5>>

<<hold_end>>

